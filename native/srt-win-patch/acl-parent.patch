+#[test]
+fn object_aces_preserve_protection_and_other_principals() {
+    let fixture = Fixture::new();
+    set_fixture_dacl(&fixture.0, "(D;OICI;0x2;;;AN)(A;OICI;FR;;;BU)");
+    let child = fixture.0.join("protected-child");
