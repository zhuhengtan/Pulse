+    set_fixture_dacl(&child, "(A;;FR;;;BU)");
+    let original = snapshot(&fixture.0);
+    let child_original = snapshot(&child);
+    for set in [
+        SbAceSet {
+            deny_fdc: true,
+            ..Default::default()
