{
  "name": "pulse",
  "private": true,
  "workspaces": ["packages/*"],
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "ci:local": "node scripts/ci/local.mjs",
    "build": "tsc -b",
    "cli:build": "node scripts/cli/build.mjs",
    "cli:dev": "node scripts/cli/dev.mjs",
    "cli:watch": "node scripts/cli/watch.mjs",
    "cli:debug": "node scripts/cli/debug.mjs",
    "cli:start": "node scripts/cli/start.mjs",
    "cli:pack": "node scripts/cli/pack.mjs",
    "cli:run-package": "node scripts/cli/run-package.mjs",
    "cli:verify-package": "node scripts/cli/verify-package.mjs",
    "cli:install": "node scripts/cli/install.mjs",
    "cli:uninstall": "node scripts/cli/uninstall.mjs",
    "eval:validate": "node scripts/eval/validate.mjs",
    "eval:grade": "node scripts/eval/grade.mjs",
    "eval:dry": "node scripts/eval/run.mjs --dry-run",
    "eval:run": "node scripts/eval/run.mjs",
    "eval:report": "node scripts/eval/report.mjs",
    "release:check": "node scripts/release/check.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:publish": "pnpm build && pnpm release:check && pnpm publish -r --access public --no-git-checks",
    "release:npm-publish": "pnpm build && pnpm release:check && node scripts/release/npm-publish.mjs",
    "release:npm-dry-run": "pnpm build && pnpm release:check && NPM_DRY_RUN=1 node scripts/release/npm-publish.mjs",
    "test": "vitest run --exclude tests/live/**",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live --passWithNoTests",
    "check": "tsc -b --pretty false && vitest run --exclude tests/live/**"
  },
  "devDependencies": {
    "@hunterzhu/pulse-cli": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
