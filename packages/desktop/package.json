{
  "name": "@hunterzhu/pulse-desktop",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "Pulse local desktop client",
  "homepage": "https://zhuhengtan.github.io/Pulse/",
  "author": "Hunter Zhu",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.27.0",
    "seek-bzip": "2.0.0",
    "sherpa-onnx-node": "2.0.1",
    "tar": "^7.5.22",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "afterPack": "scripts/archive-windows-runtime.mjs",
    "appId": "com.hunterzhu.pulse.desktop",
    "productName": "Pulse",
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/web/dist",
        "to": "web"
      },
      {
        "from": "../../artifacts/desktop-runtime/pulse",
        "to": "runtime"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "identity": "-",
      "sign": "../../scripts/desktop/sign-mac.mjs",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "artifactName": "pulse-macos-${arch}.${ext}",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSMicrophoneUsageDescription": "Pulse 在启用语音助手后使用麦克风进行名字唤醒、主人识别和语音聊天。"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "pulse-windows-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "Hunter Zhu",
      "executableName": "pulse",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "src/assets/icon.png",
      "artifactName": "pulse-linux-${arch}.${ext}"
    },
    "deb": {
      "packageName": "pulse"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "src/voice/**",
      "node_modules/**"
    ]
  }
}
