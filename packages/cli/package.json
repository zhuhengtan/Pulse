    "highlight.js": "^11.10.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^14.0.0",
    "react": "^19.0.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0"
  }
}
