{
  "name": "@hunterzhu/pulse-cli",
  "version": "0.3.0",
  "description": "A local-first AI task assistant for coding, research, and file workflows.",
  "keywords": [
    "ai",
    "agent",
    "assistant",
    "cli",
    "coding",
    "research",
    "task-runner"
  ],
  "homepage": "https://github.com/zhuhengtan/Pulse#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuhengtan/Pulse"
  },
  "type": "module",
