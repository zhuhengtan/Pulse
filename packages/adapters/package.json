{
  "name": "@hunterzhu/pulse-adapters",
  "version": "0.12.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuhengtan/Pulse"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/build/copy-adapter-assets.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@hunterzhu/pulse-runtime": "workspace:*",
    "@hunterzhu/pulse-tool-sdk": "workspace:*",
    "@napi-rs/canvas": "0.1.100",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "mammoth": "1.11.0",
    "pdfjs-dist": "4.10.38",
    "saxes": "6.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reasoning-effort": {
      "types": "./dist/providers/reasoning-effort.d.ts",
      "import": "./dist/providers/reasoning-effort.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  }
}
